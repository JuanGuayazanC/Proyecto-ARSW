@startuml Componentes_Realtime
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml
LAYOUT_LEFT_RIGHT()

Container(webapp, "Web Application", "React + TS")
Container(auth, "Auth Service", "Java 21 + Spring Boot")
ContainerDb(redis, "Estado en memoria", "Redis")

Container_Boundary(realtime, "Realtime / Ranking Service") {
  Component(interceptor, "WebSocketAuthInterceptor", "HandshakeInterceptor", "Valida el JWT en el handshake")
  Component(wsHandler, "RoomWebSocketHandler", "Spring WebSocket Handler", "Posiciones GPS, broadcast, señalización de voz")
  Component(roomManager, "RoomManager", "Spring Service", "Estado de salas en memoria")
  Component(grpcClient, "GrpcAuthClient", "grpc-java", "Resuelve el nombre autoritativo")
  Component(rankingService, "RankingService", "Spring Service", "Recalcula el ranking ante cada posición")
  Component(rankingStrategy, "RankingStrategy", "Strategy", "Cálculo intercambiable por deporte")
}

Rel(webapp, interceptor, "Handshake WebSocket con JWT", "WSS")
Rel(interceptor, wsHandler, "Conexión autenticada")
Rel(wsHandler, roomManager, "Registra sesiones y consulta salas")
Rel(wsHandler, rankingService, "Recalcula el ranking")
Rel(roomManager, grpcClient, "Resuelve el nombre autoritativo")
Rel(grpcClient, auth, "getProfile(email)", "gRPC :9090")
Rel(rankingService, rankingStrategy, "Calcula el orden según el deporte")
Rel(rankingService, redis, "Cachea el ranking (TTL 1h)", "Redis protocol")

SHOW_LEGEND()
@enduml
