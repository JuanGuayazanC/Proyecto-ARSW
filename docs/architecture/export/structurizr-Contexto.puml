@startuml Contexto
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(atleta, "Atleta", "Crea o se une a salas, transmite GPS en vivo, ve ranking y recibe reacciones.")
System(raceflow, "RaceFlow", "Salas de entrenamiento colaborativas en tiempo real.")
System_Ext(mapas, "Servicio de Mapas", "Leaflet + OpenStreetMap.")
System_Ext(geo, "API de Geolocalización", "GPS del navegador.")

Rel(atleta, raceflow, "Crea salas, transmite GPS, ve ranking", "HTTPS + WSS")
Rel(raceflow, mapas, "Solicita tiles del mapa", "HTTPS")
Rel(atleta, geo, "Obtiene coordenadas GPS")

SHOW_LEGEND()
@enduml
